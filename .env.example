# ── Clodia Agency — configurazione istanza ──────────────────────────────────
# Copia in .env (lo fa setup.sh) e compila i valori. NON committare .env.
CLODIA_ORCHESTRATOR_SECRET=

# Datadir: dove vivono TUTTI i dati dell'istanza (secrets, topics, db, pki).
# Percorso assoluto consigliato. Default: ./clodia-data
CLODIA_DATA=./clodia-data

# Stato DECISIONALE del gateway: whitelist per-agente, consensi del gate,
# deleghe. Directory montata dal SOLO container clodia-tools — NON metterla
# dentro CLODIA_DATA, che e' montata anche dall'agent-server dove girano gli
# agenti (issue #80: chi riscrive la whitelist si auto-concede i tool).
# Default: ./gateway-state
CLODIA_GATEWAY_STATE=./gateway-state

# Modello: chiave API Anthropic (provider minimo per far girare gli agenti).
# In alternativa si collega un provider OAuth dalla sezione Tools della webui.
ANTHROPIC_API_KEY=

# Mailbox reale dell'agency (per i canali di contatto via subaddressing).
# Es. la-tua-agency@gmail.com — lascia vuoto se non usi i canali email.
CLODIA_BASE_EMAIL=

# Sorgente del codice agent-server (clonato a runtime). Lascia i default.
GIT_REPO=r-clodia/clodia-logic
GIT_BRANCH=main

# Porte host (cambiale se già occupate)
AGENT_SERVER_PORT=7842
TOOLS_PORT=7849
WEBUI_PORT=7843
PWA_PORT=5173

# Integrazione opzionale: bot Telegram (si può anche configurare da UI)
TELEGRAM_BOT_TOKEN=

# Solo per sorgente privato (mirror/pre-release). Vuoto per repo pubblici.
GIT_TOKEN=

# ── Agent egress confinement (clodia-platform#104 phase 1) ───────────────────
# Empty = phase A (proxy built but unused). Set to the proxy URL for phase B:
#   CLODIA_AGENT_EGRESS_PROXY=http://egress-proxy:8888
# Phase C (the firewall rule that makes it the only route) is a separate step:
# see docker/egress/README.md.
CLODIA_AGENT_EGRESS_PROXY=
# Extra NO_PROXY entries, space-separated, if your deployment adds hostnames the
# agents must reach without the proxy.
# Comma-separated, no leading comma needed (it is appended to the list).
CLODIA_NO_PROXY_EXTRA=
# Fixed subnets: the confinement rule matches on them, so they must not drift.
CLODIA_INT_SUBNET=172.31.7.0/24
CLODIA_EXT_SUBNET=172.31.8.0/24
