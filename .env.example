# ── Clodia Agency — configurazione istanza ──────────────────────────────────
# Copia in .env (lo fa setup.sh) e compila i valori. NON committare .env.
CLODIA_ORCHESTRATOR_SECRET=

# Datadir: dove vivono TUTTI i dati dell'istanza (secrets, topics, db, pki).
# Percorso assoluto consigliato. Default: ./clodia-data
# ⚠️ macOS: NON usare una cartella del Mac. Con un runtime containerizzato
# (Colima/OrbStack/Docker Desktop) una cartella dell'host e' montata nella VM via
# virtiofs, e i permessi si comportano in modo ASIMMETRICO — misurato: dentro la
# VM `root:root 700` tiene e un uid di spawn viene negato dal kernel, ma dall'host
# lo stesso file e' `-rw-r--r-- <utente>` e si legge con un `cat`. La vault
# dell'istanza (provider, token, chiavi) sarebbe quindi leggibile da chiunque abbia
# una shell sul Mac. Usa un percorso INTERNO alla VM (es. /var/clodia-data).
CLODIA_DATA=./clodia-data

# Stato DECISIONALE del gateway: whitelist per-agente, consensi del gate,
# deleghe. Directory montata dal SOLO container clodia-tools — NON metterla
# dentro CLODIA_DATA, che e' montata anche dall'agent-server dove girano gli
# agenti (issue #80: chi riscrive la whitelist si auto-concede i tool).
# Default: ./gateway-state
CLODIA_GATEWAY_STATE=./gateway-state

# Modello: chiave API Anthropic (provider minimo per far girare gli agenti).
# In alternativa si collega un provider OAuth dalla sezione Tools della webui.
ANTHROPIC_API_KEY=

# Mailbox reale dell'agency (per i canali di contatto via subaddressing).
# Es. la-tua-agency@gmail.com — lascia vuoto se non usi i canali email.
CLODIA_BASE_EMAIL=

# Indirizzo PUBBLICO con cui una persona raggiunge la webui — non quello
# interno alla rete docker, e senza slash finale.
#   es. https://clodia.esempio.org      oppure  https://host.tuo-tailnet.ts.net:8443
# Serve alle notifiche che escono dall'istanza e devono riportare qualcuno
# dentro (la menzione recapitata su un gruppo Telegram). Lasciarlo vuoto non è
# neutro: chi lo legge RIFIUTA di configurare quel canale, invece di consegnare
# link relativi che fuori da qui non risolvono.
CLODIA_WEBUI_URL=

# Sorgente del codice agent-server (clonato a runtime). Lascia i default.
GIT_REPO=r-clodia/clodia-logic
GIT_BRANCH=main

# Porte host (cambiale se già occupate)
AGENT_SERVER_PORT=7842
TOOLS_PORT=7849
WEBUI_PORT=7843
PWA_PORT=5173

# Integrazione opzionale: bot Telegram (si può anche configurare da UI)
TELEGRAM_BOT_TOKEN=

# Solo per sorgente privato (mirror/pre-release). Vuoto per repo pubblici.
GIT_TOKEN=

# ── Agent egress confinement (clodia-platform#104 phase 1) ───────────────────
# Empty = phase A (proxy built but unused). Set to the proxy URL for phase B:
#   CLODIA_AGENT_EGRESS_PROXY=http://egress-proxy:8888
# Phase C (the firewall rule that makes it the only route) is a separate step:
# see docker/egress/README.md.
CLODIA_AGENT_EGRESS_PROXY=
# Extra NO_PROXY entries, space-separated, if your deployment adds hostnames the
# agents must reach without the proxy.
# Comma-separated, no leading comma needed (it is appended to the list).
CLODIA_NO_PROXY_EXTRA=
# Fixed subnets: the confinement rule matches on them, so they must not drift.
CLODIA_INT_SUBNET=172.31.7.0/24
CLODIA_EXT_SUBNET=172.31.8.0/24

# ── Instradamento delle menzioni ─────────────────────────────────────────────
# Salti massimi della catena di delega agente→agente (R16). Un messaggio umano
# parte da `hop 0`, quindi 4 lascia spazio a due scambi completi fra un
# coordinatore e un esecutore.
#
# È l'unico freno al rimpallo: R3 limita le menzioni per messaggio, non la
# lunghezza della catena. Alzarlo moltiplica i turni LLM che un solo messaggio
# umano può innescare — 50 significa fino a 50 turni consecutivi prima che la
# catena si fermi e lo dica. Un valore illeggibile o <= 0 ricade su 4, perché
# `0` spegnerebbe ogni delega e il guasto somiglierebbe a quello che il limite
# serve a evitare.
CLODIA_MAX_DELEGATION_HOPS=4

# ── Postura di sicurezza (default = sicuri) ──────────────────────────────────
# 1 = i gate REGISTRANO invece di bloccare: modalità di osservazione, utile per
# capire quali approvazioni servono prima di attivarle. 0 = bloccano.
CLODIA_DANGEROUSLY_SKIP_GATES=0
# Rilevazione deterministica delle anomalie di canale (mention non instradabile,
# turno morto, provider assente, richiesta d'aiuto di un agente) con risveglio
# del guardiano. Costa un turno per anomalia: si accende quando si cerca un
# guasto, o nei primi giorni di una istanza nuova.
CLODIA_DEBUG_MODE=0
CLODIA_DEBUG_DEDUP_SECONDS=600
# Secondi di silenzio dell'SDK dopo i quali il turno viene chiuso a forza.
CLODIA_TURN_WATCHDOG_SILENCE=180
# Proxy di egress del container agentico. VUOTO = l'agente non ha DNS né uscita
# (la sua rete è `internal`), quindi il clone del sorgente FALLISCE al boot:
# impostarlo è obbligatorio per un'istanza funzionante.
CLODIA_AGENT_EGRESS_PROXY=http://egress-proxy:8888

# Indirizzo su cui l'host pubblica le porte dei servizi. Default `127.0.0.1`:
# raggiungibili solo dalla macchina, e l'accesso remoto passa da un proxy
# esplicito (es. `tailscale serve`, che fa già proxy verso 127.0.0.1).
#
# Il default era `0.0.0.0`, quindi la webui e il gateway rispondevano a QUALUNQUE
# dispositivo sulla rete locale — misurato: da un'altra macchina della stessa LAN
# la webui restituiva 200 senza passare da alcuna VPN. Metterlo a `0.0.0.0` è una
# scelta legittima in una rete di cui si risponde, ma deve essere una scelta.
CLODIA_BIND_HOST=127.0.0.1
